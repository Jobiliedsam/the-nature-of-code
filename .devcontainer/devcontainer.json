{
  "name": "The Nature of Code - p5.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "runArgs": ["--memory=3g"],
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "p5.js",
      "onAutoForward": "openBrowser"
    }
  },
  "mounts": [
    "source=nature-of-code-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown node:node node_modules && npm install",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "samplavigne.p5-vscode",
        "ritwickdey.LiveServer",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n"
      }
    }
  }
}
